# Copy this file to terraform.tfvars and adjust values for your AWS account.
# The terraform.tfvars file itself is ignored by Git.

aws_region              = "us-east-2"
availability_zones      = ["us-east-2a", "us-east-2b"]
project_name            = "cloud-infra-demo"
instance_type           = "t3.micro"

asg_min_size            = 2
asg_desired_capacity    = 2
asg_max_size            = 5

ebs_volume_size_gib     = 8
create_sample_item      = false
